 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n  .sp { font-family: Arial, sans-serif; font-size: 12px; color: #333; }\n  .sp-head { border-bottom: 2px solid #1a2e4a; padding-bottom: 8px; margin-bottom: 12px; }\n  .sp-head h2 { margin: 0; font-size: 18px; color: #1a2e4a; letter-spacing: .5px; }\n  .sp-head .sub { margin-top: 2px; color: #666; }\n  table.sp-info { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n  table.sp-info td { padding: 3px 6px; vertical-align: top; }\n  table.sp-info td.k { width: 18%; color: #666; }\n  table.sp-info td.v { width: 32%; font-weight: 600; }\n  table.sp-items { width: 100%; border-collapse: collapse; }\n  table.sp-items th { background: #e3eeff; color: #1a2e4a; text-align: left; padding: 6px 8px; border: 1px solid #c9d6ea; }\n  table.sp-items td { padding: 6px 8px; border: 1px solid #dde4ef; }\n  .r { text-align: right; } .c { text-align: center; }\n  .sp-foot { margin-top: 14px; color: #888; font-size: 10px; }\n</style>\n<div class=\"sp\">\n  <div class=\"sp-head\">\n    <h2>PAKET SERVICE</h2>\n    <div class=\"sub\">{{ doc.package_name }}{% if doc.code %} &middot; {{ doc.code }}{% endif %} ({{ doc.name }})</div>\n  </div>\n  <table class=\"sp-info\">\n    <tr>\n      <td class=\"k\">Company</td><td class=\"v\">{{ doc.company }}</td>\n      <td class=\"k\">Status</td><td class=\"v\">{{ \"Aktif\" if doc.is_active else \"Tidak aktif\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"k\">Cabang</td>\n      <td class=\"v\">{% if doc.is_all_branch %}Semua cabang{% else %}{{ doc.branches | map(attribute=\"branch\") | join(\", \") }}{% endif %}</td>\n      <td class=\"k\">Transmisi</td><td class=\"v\">{{ doc.transmission or \"ALL\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"k\">Merk</td><td class=\"v\">{{ doc.vehicle_manufacture or \"Semua\" }}</td>\n      <td class=\"k\">Model</td><td class=\"v\">{{ doc.vehicle_model or \"Semua\" }}</td>\n    </tr>\n  </table>\n  <table class=\"sp-items\">\n    <thead>\n      <tr><th class=\"c\" style=\"width:40px\">No</th><th style=\"width:20%\">Kode</th><th>Barang / Jasa</th><th class=\"r\" style=\"width:80px\">Qty</th><th class=\"c\" style=\"width:70px\">Satuan</th><th class=\"r\" style=\"width:120px\">Harga</th></tr>\n    </thead>\n    <tbody>\n    {% for row in doc.items %}\n      <tr>\n        <td class=\"c\">{{ loop.index }}</td>\n        <td>{{ row.item_code }}</td>\n        <td>{{ row.item_name or \"\" }}</td>\n        <td class=\"r\">{{ \"%g\"|format(row.qty) }}</td>\n        <td class=\"c\">{{ row.uom or \"\" }}</td>\n        <td class=\"r\">{% if row.rate %}{{ row.get_formatted(\"rate\", doc) }}{% else %}Daftar harga{% endif %}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n  <div class=\"sp-foot\">Dicetak {{ frappe.utils.format_datetime(frappe.utils.now_datetime(), \"dd-MM-yyyy HH:mm\") }}</div>\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
